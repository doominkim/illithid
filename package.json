{
  "name": "illithid",
  "version": "0.4.1",
  "private": true,
  "description": "Illithid — a GUI that manages Claude Code, Codex, and OpenCode settings from a single source library",
  "main": "./out/main/index.js",
  "author": "Dominic",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "start": "electron-vite preview",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:engine",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:fixtures",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:fixtures": "tsx scripts/git-fixture.ts && tsx scripts/model-stats-fixture.ts && tsx scripts/session-scan-fixture.ts",
    "test:ui": "electron-vite build && tsx --test --test-concurrency=1 scripts/*.ui.test.ts",
    "test:local": "tsx scripts/apply-fixture.ts && tsx scripts/market-fixture.ts && tsx scripts/m7-fixture.ts",
    "postinstall": "electron-builder install-app-deps",
    "git-fixture": "tsx scripts/git-fixture.ts",
    "screens": "electron-vite build && tsx scripts/screens.ts",
    "apply-fixture": "tsx scripts/apply-fixture.ts",
    "session-scan-fixture": "tsx scripts/session-scan-fixture.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mantine/charts": "^9.6.2",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@mantine/spotlight": "^9.6.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/keyring": "2.1.0",
    "@tanstack/react-virtual": "^3.14.13",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shell-env": "^4.0.3",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "^1.63.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "license": "MIT"
}
